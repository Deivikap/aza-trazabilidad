# Caddy obtiene y renueva solos los certificados TLS (Let's Encrypt). DOMAIN viene de .env.prod
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 1MB
	}
	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
	}
}
