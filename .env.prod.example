# Copia a .env.prod (chmod 600) y completa. NUNCA subas .env.prod al repositorio.
DOMAIN=aza.midominio.cl                 # o <IP-con-guiones>.sslip.io si no tienes dominio, p. ej. 3-210-5-9.sslip.io
DJANGO_SECRET_KEY=                      # genera: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=aza.midominio.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://aza.midominio.cl
DB_PASSWORD=
DB_ROOT_PASSWORD=
MONGO_USER=aza_mongo
MONGO_PASSWORD=
# Correo real para recuperar contraseña (opcional; sin esto el enlace se imprime en los logs del contenedor)
